
flowchart TB

    subgraph P["CAPA DE PRESENTACIÓN"]
        direction LR
        Server["Server<br/>Servidor HTTP y rutas API<br/>Sirve archivos web"]
        HU["HttpUtil<br/>Lee solicitudes<br/>Genera respuestas JSON"]
        Server --> HU
    end

    subgraph N["CAPA DE NEGOCIO / APLICACIÓN"]
        direction TB

        subgraph NS["SERVICIOS PRINCIPALES"]
            direction LR
            PS["ProductoService<br/>Consulta productos"]
            CS["ClienteService<br/>Consulta y registra clientes"]
            OS["PedidoService<br/>Crea pedidos<br/>Valida reglas y estados"]
        end

        subgraph NA["SERVICIOS DE APOYO"]
            direction LR
            FS["FidelidadService<br/>Descuentos y DevPoints<br/>Actualiza nivel del cliente"]
            IS["InventarioService<br/>Valida stock<br/>Descuenta existencias"]
        end

        OS --> FS
        OS --> IS
    end

    subgraph D["CAPA DE PERSISTENCIA / DATOS"]
        direction TB

        subgraph I["INTERFACES DAO · CONTRATOS"]
            direction LR
            PI[["ProductoDAO"]]
            CI[["ClienteDAO"]]
            OI[["PedidoDAO"]]
        end

        subgraph J["IMPLEMENTACIONES JSON"]
            direction LR
            JP["JsonProductoDAO"]
            JC["JsonClienteDAO"]
            JO["JsonPedidoDAO"]
        end

        DB["JsonDatabase<br/>Lee y escribe archivos JSON<br/>Convierte registros y objetos"]
        MJ["MiniJson<br/>Parsea y serializa JSON"]

        PI -. "implementado por" .-> JP
        CI -. "implementado por" .-> JC
        OI -. "implementado por" .-> JO

        JP --> DB
        JC --> DB
        JO --> DB
        DB --> MJ
    end

    Server --> PS
    Server --> CS
    Server --> OS

    PS --> PI
    CS --> CI

    OS --> PI
    OS --> CI
    OS --> OI

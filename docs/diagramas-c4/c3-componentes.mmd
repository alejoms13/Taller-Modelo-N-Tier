
flowchart TB

    subgraph P["CAPA DE PRESENTACIÓN"]
        direction LR
        Server["Server<br/>Servidor HTTP · API<br/>Archivos estáticos"]
        HU["HttpUtil<br/>Lee solicitudes<br/>Respuestas JSON"]
        Server --> HU
    end

    subgraph N["CAPA DE NEGOCIO / APLICACIÓN"]
        direction TB

        subgraph N1["SERVICIOS PRINCIPALES"]
            direction LR
            PS["ProductoService<br/>Lista productos"]
            CS["ClienteService<br/>Lista y registra clientes"]
            OS["PedidoService<br/>Crea pedidos<br/>Valida pendientes<br/>Gestiona estados"]
        end

        subgraph N2["SERVICIOS DE APOYO"]
            direction LR
            FS["FidelidadService<br/>Descuentos por nivel<br/>DevPoints y ascensos"]
            IS["InventarioService<br/>Valida stock<br/>Descuenta existencias"]
        end

        OS --> FS
        OS --> IS
    end

    subgraph D["CAPA DE PERSISTENCIA / DATOS"]
        direction TB

        subgraph D1["DAO: ACCESO A DATOS"]
            direction LR
            PDA["JsonProductoDAO<br/>Listar · Buscar<br/>Guardar · Actualizar"]
            CDA["JsonClienteDAO<br/>Listar · Buscar<br/>Guardar · Actualizar"]
            ODA["JsonPedidoDAO<br/>Listar · Buscar<br/>Guardar · Actualizar"]
        end

        DB["JsonDatabase<br/>Lee y escribe archivos<br/>Convierte objetos y registros"]
        MJ["MiniJson<br/>Parsea y serializa JSON"]

        PDA --> DB
        CDA --> DB
        ODA --> DB
        DB --> MJ
    end

    Server --> PS
    Server --> CS
    Server --> OS

    PS --> PDA
    CS --> CDA
    OS --> PDA
    OS --> CDA
    OS --> ODA
